# ---- Required ----
GROQ_API_KEY=your_groq_api_key_here

# Postgres (Supabase / Render / Neon...). If omitted, falls back to local SQLite (dev only).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Recommended in production ----
# Comma-separated frontend origins allowed to call the API (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# ---- Optional ----
# Path to tesseract binary if it isn't on PATH
# TESSERACT_CMD=/usr/bin/tesseract

# Vendor email sending (leave blank for draft-only mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
